<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and site.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and site.announcements.limit %}
          {% assign news_limit = site.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% include news_rows.liquid items=news limit=news_limit offset=0 %}
      </table>
    </div>
    {% if include.limit and news_size > news_limit %}
      {% assign older_count = news_size | minus: news_limit %}
      <details class="older-news">
        <summary>Older news <span class="older-news-count">({{ older_count }})</span></summary>
        <div class="table-responsive">
          <table class="table table-sm table-borderless">
            {% include news_rows.liquid items=news offset=news_limit limit=news_size %}
          </table>
        </div>
      </details>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
