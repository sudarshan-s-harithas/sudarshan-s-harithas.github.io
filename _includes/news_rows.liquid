{% for item in include.items limit: include.limit offset: include.offset %}
          <tr>
            <th scope="row" style="width: 20%">
              {% if item.date_label %}
                {{ item.date_label }}
              {% else %}
                {{ item.date | date: '%b %Y' }}
              {% endif %}
            </th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
