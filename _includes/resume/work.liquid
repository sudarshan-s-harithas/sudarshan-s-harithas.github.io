<div class="work-history">
  {% assign work = data[1] | group_by: 'name' %}
  {% for organization in work %}
    {% assign first_role = organization.items.first %}
    <section class="work-organization" aria-label="{{ organization.name | escape }}">
      <h4><a href="{{ first_role.url }}">{{ organization.name }}</a></h4>
      <p class="work-advisor">{{ first_role.summary }}</p>
      {% for role in organization.items %}
        <div class="work-role">
          <div class="work-role-heading">
            <h5>{{ role.position }}</h5>
            <span class="work-dates">{{ role.startDate | date: '%B %Y' }}–{% if role.endDate %}{{ role.endDate | date: '%B %Y' }}{% else %}Present{% endif %}</span>
          </div>
          <ul>
            {% for highlight in role.highlights %}<li>{{ highlight }}</li>{% endfor %}
          </ul>
        </div>
      {% endfor %}
    </section>
  {% endfor %}
</div>
